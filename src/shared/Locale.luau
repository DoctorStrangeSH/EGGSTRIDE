    ["Небесный светляк"] = "Sky Firefly",
    ["Закатный светляк"] = "Sunset Firefly",
    ["Лунный светляк"] = "Lunar Firefly",
    ["Полярный светляк"] = "Polar Firefly",
}

-- Russian is the fallback for languages outside the available translations.
function Locale.language(localeId)
    local code = string.lower(localeId or "")
    return if code == "en" or string.sub(code, 1, 3) == "en-" then "en" else "ru"
end

function Locale.text(language, source, ...)
    local value = if language == "en" then english[source] or source else source
    if select("#", ...) > 0 then
        return string.format(value, ...)
    end
    return value
end

function Locale.deliveryTime(language, milliseconds)
    local seconds = string.format("%.2f", milliseconds / 1000)
    if language == "en" then
        return seconds .. "s"
    end
    return (seconds:gsub("%.", ",")) .. " сек."
end

function Locale.weeklySplit(language, milliseconds, reference)
    local time = Locale.deliveryTime(language, milliseconds)
    if not reference then
        return Locale.text(language, "От старта · %s", time)
    end
    local delta = math.round((milliseconds - reference) / 10) * 10
    if delta == 0 then
        return Locale.text(language, "%s · Вровень с рекордом", time)
    end
    local gap = Locale.deliveryTime(language, math.abs(delta))
    return Locale.text(language, if delta < 0 then "%s · %s быстрее" else "%s · %s медленнее", time, gap)
end

return Locale
